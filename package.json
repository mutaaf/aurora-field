{
  "name": "aurora-field",
  "version": "3.0.0",
  "description": "A zero-dependency WebGL particle field: lit, solid shapes that morph; people drawn by a pen of light then lit; storyboards as JSON on a stage; React. Text, SVG, images, rigged helmets, a web component, worker mode.",
  "main": "src/aurora-field.js",
  "browser": "src/aurora-field.js",
  "types": "src/aurora-field.d.ts",
  "exports": {
    ".": {
      "types": "./src/aurora-field.d.ts",
      "import": "./dist/aurora-field.mjs",
      "require": "./src/aurora-field.js",
      "default": "./src/aurora-field.js"
    },
    "./element": {
      "import": "./dist/aurora-field-element.mjs",
      "default": "./src/element.js"
    },
    "./worker": "./dist/aurora-field.worker.js",
    "./package.json": "./package.json",
    "./face": "./src/face.mjs",
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.mjs"
    },
    "./storyboards/*": "./examples/*",
    "./min": "./dist/aurora-field.min.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "examples",
    "react",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node test/run.mjs",
    "bench": "node bench/run.mjs",
    "budget": "node scripts/build.mjs && node bench/run.mjs --budget",
    "render": "node scripts/render.mjs",
    "demo": "python3 -m http.server 8080",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "canvas",
    "webgl",
    "particles",
    "web component",
    "custom element",
    "offscreencanvas",
    "web worker",
    "svg",
    "text",
    "generative",
    "hero",
    "animation",
    "landing page",
    "zero-dependency",
    "face tracking",
    "mediapipe"
  ],
  "author": "Mutaaf Aziz (https://mutaafaziz.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutaaf/aurora-field.git"
  },
  "homepage": "https://mutaaf.github.io/aurora-field/",
  "sideEffects": [
    "./src/element.js",
    "./dist/aurora-field-element.mjs"
  ],
  "module": "dist/aurora-field.mjs",
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.60.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
