{
  "name": "aurora-field",
  "version": "1.1.0",
  "description": "A zero-dependency WebGL particle field that assembles into shapes and morphs between them: a neural sphere, helmets, text, SVG, images. Two-tone palettes, live options, a web component, worker mode.",
  "main": "src/aurora-field.js",
  "browser": "src/aurora-field.js",
  "types": "src/aurora-field.d.ts",
  "exports": {
    ".": {
      "types": "./src/aurora-field.d.ts",
      "import": "./dist/aurora-field.mjs",
      "require": "./src/aurora-field.js",
      "default": "./src/aurora-field.js"
    },
    "./element": {
      "import": "./dist/aurora-field-element.mjs",
      "default": "./src/element.js"
    },
    "./worker": "./dist/aurora-field.worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node test/run.mjs",
    "bench": "node bench/run.mjs",
    "demo": "python3 -m http.server 8080",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "canvas",
    "webgl",
    "particles",
    "web component",
    "custom element",
    "offscreencanvas",
    "web worker",
    "svg",
    "text",
    "generative",
    "hero",
    "animation",
    "landing page",
    "zero-dependency"
  ],
  "author": "Mutaaf Aziz (https://mutaafaziz.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutaaf/aurora-field.git"
  },
  "homepage": "https://mutaaf.github.io/aurora-field/",
  "sideEffects": [
    "./src/element.js",
    "./dist/aurora-field-element.mjs"
  ],
  "module": "dist/aurora-field.mjs"
}
